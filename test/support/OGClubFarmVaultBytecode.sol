pragma solidity ^0.8.24;

/// @notice Creation code of the live OGClubFarmVault at 0x60401e748d6c3a1f2775bE9e6a41bda20eDa0B80 on
///         Ethereum mainnet, copied byte for byte from the chain (creation input minus its two ABI-encoded
///         constructor words, token 0xce7eB1ad9e2E1c784eA05F7EA4A0fE625923D10A and owner
///         0x5b95a971b4583a5f011e9da082acdd679b870d06). Solidity 0.8.26 per its CBOR tail. Its source is not
///         verified on any explorer, so the integration test deploys these exact bytes with its own
///         constructor arguments and drives them through {IOGClubFarmVault}, whose selectors were
///         resolved from the runtime's dispatcher.
interface IOGClubFarmVault {
    function token() external view returns (address);
    function owner() external view returns (address);
    function reserved() external view returns (uint256);
    function seasonCount() external view returns (uint256);
    function CLAIM_DELAY() external view returns (uint256);
    function CLAIM_PERIOD() external view returns (uint256);
    function PROPOSAL_INTERVAL() external view returns (uint256);
    function claimed(uint256 season, address account) external view returns (bool);
    function proposeSeason(bytes32 root, uint256 total) external returns (uint256 season);
    function claim(uint256 season, address account, uint256 amount, bytes32[] calldata proof) external;

    error BudgetExceeded();
    error ClaimsNotOpen();
    error InvalidSeason();
}

library OGClubFarmVaultBytecode {
    /// @notice The live runtime code, read from the chain. Its two immutables (the token, a PUSH32 in
    ///         the code) are the mainnet values, so a copy deployed with that token must match it exactly.
    bytes internal constant LIVE_RUNTIME = hex"";
    address internal constant LIVE_TOKEN = 0xCe7EB1Ad9e2E1c784ea05F7eA4A0Fe625923D10A;
    address internal constant LIVE_OWNER = 0x5b95A971B4583A5f011E9DA082acdD679b870D06;

    bytes internal constant INIT_CODE = hex"";

    /// @notice Deploys the real vault bytecode with `constructor(IERC20 token, address owner)`.
    function deploy(address token, address owner) internal returns (address vault) {
        bytes memory code = abi.encodePacked(INIT_CODE, abi.encode(token, owner));
        assembly ("memory-safe") {
            vault := create(0, add(code, 0x20), mload(code))
        }
        require(vault != address(0), "vault deploy failed");
    }
}
